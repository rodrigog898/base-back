generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  email               String    @unique
  passwordHash        String
  role                Role      @default(USER)
  isActive            Boolean   @default(true)
  isBlocked           Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  loginBlockedUntil   DateTime?
  bannedUntil         DateTime? @map("banned_until")
  lastConnectionAt    DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

/// Sesión de refresh token. Sólo se guarda el hash SHA-256 del token.
model Session {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  refreshToken String    @unique
  expiresAt    DateTime
  ip           String?
  userAgent    String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

/// Registro de auditoría de seguridad (append-only, A.8.15).
model AuthSecurityLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  email       String
  event       String
  outcome     String?
  description String
  userId      String?  @db.ObjectId
  ip          String?
  userAgent   String?
  requestId   String?
  createdAt   DateTime @default(now())

  @@index([email, createdAt])
  @@index([userId, createdAt])
  @@map("auth_security_log")
}

model AuthIpThrottle {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  ip             String    @unique
  failedAttempts Int       @default(0)
  blockedUntil   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("auth_ip_throttle")
}
