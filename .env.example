# ─── Servidor ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
SERVICE_NAME=base-back
# SERVICE_VERSION se toma de package.json si no se define (en CI usar el SHA/tag)

# ─── Base de datos MongoDB ───────────────────────────────────
# En producción: usuario de mínimo privilegio + TLS (?tls=true)
DATABASE_URL="mongodb://localhost:27017/base-negocio?directConnection=true"

# ─── JWT ─────────────────────────────────────────────────────
# Generar con: openssl rand -hex 48   (en producción ≥ 64 caracteres y distintos)
JWT_ACCESS_SECRET=dev-only-access-secret-replace-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-only-refresh-secret-replace-me-0123456789abcdef
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=base-back
JWT_AUDIENCE=base-front

# ─── Cookie del refresh token ────────────────────────────────
REFRESH_COOKIE_NAME=refresh_token
# COOKIE_SECURE=true          # por defecto true en producción
COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=.midominio.com

# ─── Red ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4000
# Detrás de un proxy/load balancer: número de saltos (1) o lista de IPs. Nunca "true" a ciegas.
TRUST_PROXY=false
BODY_LIMIT=100kb

# ─── Rate limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=800
# Ignorado en producción
RATE_LIMIT_SKIP_LOCALHOST=true
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=40

# ─── Bloqueo por fuerza bruta ────────────────────────────────
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=10

# ─── Logging (JSON a stdout) ─────────────────────────────────
LOG_LEVEL=info
# LOG_FILE=logs/app.log       # opcional: además de stdout (rotar con logrotate)
CLIENT_LOGS_ENABLED=true

# ─── Admin (sólo para npm run seed) ──────────────────────────
ADMIN_EMAIL=admin@base-negocio.com
ADMIN_PASSWORD=
